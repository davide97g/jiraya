      "button.foreground": "#FFFFFF",
      "button.hoverBackground": "#6B1818",
      "button.secondaryBackground": "#14161A",
      "button.secondaryForeground": "#AEB4BF",
      "button.secondaryHoverBackground": "#2A2E35",
      "chat.slashCommandBackground": "#2A2E35",
      "chat.slashCommandForeground": "#AEB4BF",
      "chat.editedFileForeground": "#8C7A3D",
      "checkbox.background": "#14161A",
      "checkbox.border": "#2A2E35",
      "debugToolBar.background": "#14161A",
      "descriptionForeground": "#6B7280",
      "dropdown.background": "#14161A",
      "dropdown.border": "#2A2E35",
      "dropdown.foreground": "#AEB4BF",
      "dropdown.listBackground": "#0E0F11",
      "editor.background": "#0E0F11",
      "editor.findMatchBackground": "#8C7A3D80",
      "editor.foreground": "#AEB4BF",
      "editorGroup.border": "#2A2E35",
      "editorGroupHeader.tabsBackground": "#14161A",
      "editorGroupHeader.tabsBorder": "#2A2E35",
      "editorGutter.addedBackground": "#2F6F5E",
      "editorGutter.deletedBackground": "#8B1E1E",
      "editorGutter.modifiedBackground": "#8C7A3D",
      "editorLineNumber.activeForeground": "#AEB4BF",
      "editorLineNumber.foreground": "#6B7280",
      "editorOverviewRuler.border": "#0E0F11",
      "editorWidget.background": "#14161A",
      "editorWidget.border": "#2A2E35",
      "errorForeground": "#8B1E1E",
      "focusBorder": "#8B1E1E",
      "foreground": "#AEB4BF",
      "icon.foreground": "#AEB4BF",
      "input.background": "#14161A",
      "input.border": "#2A2E35",
      "input.foreground": "#AEB4BF",
      "input.placeholderForeground": "#6B7280",
      "inputOption.activeBackground": "#8B1E1E40",
      "inputOption.activeBorder": "#8B1E1E",
      "keybindingLabel.foreground": "#AEB4BF",
      "list.activeSelectionBackground": "#2A2E35",
      "list.activeSelectionForeground": "#AEB4BF",
      "list.focusBackground": "#2A2E35",
      "list.hoverBackground": "#1E2025",
      "list.inactiveSelectionBackground": "#1E2025",
      "menu.background": "#14161A",
      "menu.border": "#2A2E35",
      "menu.foreground": "#AEB4BF",
      "menu.selectionBackground": "#2A2E35",
      "menu.selectionForeground": "#AEB4BF",
      "notificationCenterHeader.background": "#14161A",
      "notificationCenterHeader.foreground": "#AEB4BF",
      "notifications.background": "#14161A",
      "notifications.border": "#2A2E35",
      "notifications.foreground": "#AEB4BF",
      "panel.background": "#14161A",
      "panel.border": "#2A2E35",
      "panelInput.border": "#2A2E35",
      "panelTitle.activeBorder": "#8B1E1E",
      "panelTitle.activeForeground": "#AEB4BF",
      "panelTitle.inactiveForeground": "#6B7280",
      "peekViewEditor.background": "#14161A",
      "peekViewEditor.matchHighlightBackground": "#8C7A3D40",
      "peekViewResult.background": "#14161A",
      "peekViewResult.matchHighlightBackground": "#8C7A3D40",
      "pickerGroup.border": "#2A2E35",
      "progressBar.background": "#2F6F5E",
      "quickInput.background": "#14161A",
      "quickInput.foreground": "#AEB4BF",
      "quickInputList.focusBackground": "#2A2E35",
      "settings.dropdownBackground": "#14161A",
      "settings.dropdownBorder": "#2A2E35",
      "settings.headerForeground": "#AEB4BF",
      "settings.modifiedItemIndicator": "#8C7A3D",
      "sideBar.background": "#14161A",
      "sideBar.border": "#2A2E35",
      "sideBar.foreground": "#AEB4BF",
      "sideBarSectionHeader.background": "#14161A",
      "sideBarSectionHeader.border": "#2A2E35",
      "sideBarSectionHeader.foreground": "#AEB4BF",
      "sideBarTitle.foreground": "#AEB4BF",
      "statusBar.background": "#14161A",
      "statusBar.border": "#2A2E35",
      "statusBar.debuggingBackground": "#8B1E1E",
      "statusBar.debuggingForeground": "#FFFFFF",
      "statusBar.focusBorder": "#8B1E1E",
      "statusBar.foreground": "#AEB4BF",
      "statusBar.noFolderBackground": "#0E0F11",
      "statusBarItem.focusBorder": "#8B1E1E",
      "statusBarItem.prominentBackground": "#2A2E35",
      "statusBarItem.remoteBackground": "#2F6F5E",
      "statusBarItem.remoteForeground": "#FFFFFF",
      "statusBarItem.warningBackground": "#8C7A3D",
      "statusBarItem.warningForeground": "#0E0F11",
      "statusBarItem.errorBackground": "#8B1E1E",
      "statusBarItem.errorForeground": "#FFFFFF",
      "tab.activeBackground": "#0E0F11",
      "tab.activeBorder": "#0E0F11",
      "tab.activeBorderTop": "#8B1E1E",
      "tab.activeForeground": "#AEB4BF",
      "tab.border": "#2A2E35",
      "tab.hoverBackground": "#1E2025",
      "tab.inactiveBackground": "#14161A",
      "tab.inactiveForeground": "#6B7280",
      "tab.unfocusedActiveBorder": "#0E0F11",
      "tab.unfocusedActiveBorderTop": "#2A2E35",
      "tab.unfocusedHoverBackground": "#1E2025",
      "terminal.foreground": "#AEB4BF",
      "terminal.tab.activeBorder": "#2F6F5E",
      "textBlockQuote.background": "#14161A",
      "textBlockQuote.border": "#2A2E35",
      "textCodeBlock.background": "#14161A",
      "textLink.activeForeground": "#AEB4BF",
      "textLink.foreground": "#AEB4BF",
      "textPreformat.background": "#1E2025",
      "textPreformat.foreground": "#AEB4BF",
      "textSeparator.foreground": "#2A2E35",
      "titleBar.activeBackground": "#14161A",
      "titleBar.activeForeground": "#AEB4BF",
      "titleBar.border": "#2A2E35",
      "titleBar.inactiveBackground": "#0E0F11",
      "titleBar.inactiveForeground": "#6B7280",
      "welcomePage.progress.foreground": "#2F6F5E",
      "welcomePage.tileBackground": "#14161A",
      "widget.border": "#2A2E35",
      "widget.shadow": "#00000040"
    },
    "workbenchThemeId": "chiraiya-ninja-dark",
    "colorThemePath": "extensions/theme-defaults/themes/chiraiya-ninja-dark.json",
    "shadowsAndDepth": {
      "panelDropShadow": "0 1px 3px rgba(0,0,0,0.25)",
      "sidebarDropShadow": "0 1px 3px rgba(0,0,0,0.25)",
      "editorGroupBorderFocus": "1px solid #8B1E1E",
      "focusOutline": "1px solid #8B1E1E"
    },
    "themeScopedExample": "Use workbench.colorCustomizations with key [Chiraiya Ninja Dark] to apply these colors only when that theme is active; otherwise use the flat object as default dark customizations."
  },
  "panelRegistration": {
    "disableDefaultChat": true,
    "defaultChatViewContainerId": null,
    "defaultChatViewId": null,
    "chiraiyaScroll": {
      "id": "workbench.view.chiraiyaScroll",
      "containerId": "workbench.view.chiraiyaScrollContainer",
      "title": "Chiraiya Scroll",
      "location": "auxiliaryBar",
      "side": "right",
      "order": 1,
      "icon": "codicon-book",
      "when": "!config.chiraiya.modeZenOnly"
    },
    "workArtifacts": {
      "id": "workbench.view.workArtifacts",
      "containerId": "workbench.view.workArtifactsContainer",
      "title": "Work Artifacts",
      "location": "sidebar",
      "side": "left",
      "order": 0,
      "icon": "codicon-list-unordered",
      "when": "!config.chiraiya.modeZenOnly"
    },
    "viewContainersOrder": ["workbench.view.workArtifactsContainer", "explorer", "workbench.view.chiraiyaScrollContainer"]
  },
  "viewLayoutPerMode": {
    "zen": {
      "description": "Minimal UI — editor + status bar + optional chat only",
      "sidebarLeft": "hidden",
      "sidebarRight": "hidden",
      "panel": "hidden",
      "auxiliaryBar": "optional_chiraiya_scroll",
      "activityBar": "hidden",
      "titleBar": "minimal",
      "statusBar": "visible",
      "zenModeSettings": {
        "workbench.activityBar.location": "hidden",
        "workbench.sideBar.location": "hidden",
        "workbench.panel.opensMaximized": false,
        "chiraiya.scroll.visible": "optional"
      }
    },
    "execution": {
      "description": "Left Work Artifacts + center editor + right Chiraiya Scroll; no popups; limited commands",
      "sidebarLeft": "workArtifacts",
      "sidebarRight": "hidden",
      "panel": "hidden",
      "auxiliaryBar": "chiraiyaScroll",
      "activityBar": "visible",
      "titleBar": "visible",
      "statusBar": "visible",
      "restrictions": {
        "noPopups": true,
        "limitedCommands": ["workbench.action.quickOpen", "workbench.action.terminal.toggleTerminal"],
        "hideNotifications": "toast_only"
      }
    },
    "review": {
      "description": "Flexible layout — summary + diffs + artifacts expanded",
      "sidebarLeft": "workArtifacts_expanded",
      "sidebarRight": "chiraiyaScroll",
      "panel": "visible",
      "auxiliaryBar": "optional",
      "activityBar": "visible",
      "titleBar": "visible",
      "statusBar": "visible",
      "defaultPanelView": "timeline",
      "artifactsExpanded": true
    }
  },
  "chatStyle": {
    "layout": "chiraiya_scroll",
    "noSpeechBubbles": true,
    "noAvatars": true,
    "messageLayout": "flat",
    "formatting": {
      "messagesAsBulletPoints": true,
      "bulletCharacter": "•",
      "indentSpaces": 2,
      "collapsedReasoningSections": true,
      "reasoningSectionTitle": "Reasoning",
      "reasoningCollapsedByDefault": true
    },
    "animations": {
      "enabled": true,
      "workingIndicator": "breathing_dot",
      "breathingDotDurationMs": 1800,
      "breathingDotColor": "#AEB4BF",
      "noMessageEntranceAnimation": true,
      "noScrollAnimations": true
    },
    "colors": {
      "messageForeground": "#AEB4BF",
      "userMessageForeground": "#AEB4BF",
      "assistantMessageForeground": "#AEB4BF",
      "border": "#2A2E35",
      "background": "#14161A",
      "inputBackground": "#0E0F11",
      "inputBorder": "#2A2E35",
      "accent": "#8B1E1E",
      "success": "#2F6F5E",
      "warning": "#8C7A3D"
    },
    "cssOverrides": [
      ".chat-widget .message-bubble { border-radius: 0; box-shadow: none; background: transparent; }",
      ".chat-widget .avatar { display: none; }",
      ".chat-widget .message-content { list-style-type: disc; padding-left: 1.5rem; }",
      ".chat-widget .reasoning-section { border-left: 1px solid var(--vscode-panel-border); }"
    ]
  },
  "artifactsStyle": {
    "layout": "bullet_lists",
    "sections": ["tasks", "files", "checks", "scripts"],
    "sectionHeadersOnly": true,
    "noTimestamps": true,
    "listStyle": {
      "tasks": "bullet",
      "files": "bullet",
      "checks": "bullet",
      "scripts": "bullet"
    },
    "colors": {
      "sectionHeaderForeground": "#AEB4BF",
      "sectionHeaderBorder": "#2A2E35",
      "itemForeground": "#AEB4BF",
      "itemSuccessForeground": "#2F6F5E",
      "itemWarningForeground": "#8C7A3D",
      "itemErrorForeground": "#8B1E1E",
      "background": "#14161A",
      "border": "#2A2E35"
    },
    "liveUpdate": true,
    "updateSource": "agents",
    "minimalAnimations": true
  },
  "branding": {
    "statusBar": {
      "leftItems": ["chiraiya_logo", "mode_indicator"],
      "chiraiyaLogo": "🥷 Chiraiya",
      "chiraiyaLogoAriaLabel": "Chiraiya"
    },
    "startup": {
      "messageEnabled": true,
      "messageText": "Silence sharpens the blade.",
      "messageDurationMs": 3000,
      "noFlashyAnimations": true,
      "toastStyle": "minimal"
    },
    "windowTitle": "Chiraiya",
    "productNameShort": "Chiraiya",
    "noFlashyAnimations": true
  }
}
