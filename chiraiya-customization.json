{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/extensions/theme-defaults/package.json",
  "description": "Chiraiya — Ninja-inspired, calm, minimal, structured editor. Theme, panels, modes, chat style, artifacts, branding. Implementation-ready for VS Code fork.",
  "themeColors": {
